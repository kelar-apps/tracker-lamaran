# Copy this file to .env and fill in the values (see SETUP.md).

# OAuth Client ID (Web application) from Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com

# URL of the deployed "Lisensi" Apps Script web app (ends with /exec).
VITE_LICENSE_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Product id checked against the "produk" column in the Pembeli sheet.
VITE_PRODUCT_ID=tracker-lamaran

# Checkout page (e.g. your Lynk.id product link).
VITE_BUY_URL=https://lynk.id/username/tracker-lamaran

# Contact email shown on the public pages (tentang.html, privasi.html).
VITE_CONTACT_EMAIL=halo@contoh.com

# Base path for the build. Use "/" locally; on GitHub Pages use "/<repo-name>/".
VITE_BASE=/
